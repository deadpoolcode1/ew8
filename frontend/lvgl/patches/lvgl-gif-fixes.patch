diff --git a/src/libs/gif/lv_gif.c b/src/libs/gif/lv_gif.c
index 920f77689..247e84e8c 100644
--- a/src/libs/gif/lv_gif.c
+++ b/src/libs/gif/lv_gif.c
@@ -198,6 +198,14 @@ static void next_frame_task_cb(lv_timer_t * t)
 {
     lv_obj_t * obj = t->user_data;
     lv_gif_t * gifobj = (lv_gif_t *) obj;
+
+    /* Skip frame decoding if the GIF or any ancestor is hidden */
+    lv_obj_t * check = obj;
+    while(check) {
+        if(lv_obj_has_flag(check, LV_OBJ_FLAG_HIDDEN)) return;
+        check = lv_obj_get_parent(check);
+    }
+
     uint32_t elaps = lv_tick_elaps(gifobj->last_call);
     if(elaps < gifobj->gif->gce.delay * 10) return;
 
